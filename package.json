{
  "name": "@yusufkaranib/queuecraft",
  "version": "0.1.1",
  "description": "Typed AWS SQS publishing and worker utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "queuecraft-dashboard": "dist/dashboard-cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/dashboard-cli.ts --format esm --dts --clean --target node20",
    "dashboard:demo": "npm run build && node scripts/dashboard-demo.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:aws": "npm run build && node scripts/aws-integration.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "aws",
    "sqs",
    "queue",
    "worker"
  ],
  "author": "Yusuf Karanib",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yusuf-Karanib/QueueCraft.git"
  },
  "bugs": {
    "url": "https://github.com/Yusuf-Karanib/QueueCraft/issues"
  },
  "homepage": "https://github.com/Yusuf-Karanib/QueueCraft#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1092.0",
    "@aws-sdk/client-sqs": "^3.1092.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
